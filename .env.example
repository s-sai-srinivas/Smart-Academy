# Database
DB_USER=coding_user
DB_PASSWORD=change_me_to_a_secure_password
DB_NAME=coding_platform

# JWT (REQUIRED - must be set)
JWT_SECRET=change_me_to_a_random_secret_key_at_least_32_chars
JWT_ISSUER=smart-academy
