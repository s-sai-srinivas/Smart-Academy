# Server Configuration
PORT=8080
GIN_MODE=release

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=coding_user
DB_PASSWORD=your_secure_password
DB_NAME=coding_platform

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_to_something_secure

# Judge0 Configuration
JUDGE0_URL=http://localhost:2358

# JPlag Configuration (Plagiarism Detection)
JPLAG_BASE_DIR=/opt/jplag
JPLAG_SUBMISSIONS_DIR=/opt/jplag/submissions
JPLAG_RESULTS_DIR=/opt/jplag/results
JPLAG_DOCKER_IMAGE=jplag
JPLAG_TIMEOUT_SECONDS=60

# Super Admin Bootstrap (platform-level admin with no college)
SUPER_ADMIN_REGDNO=SUPERADMIN001
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=change_this_to_a_secure_password

# AI Configuration (Quiz Generation)
# AI_PROVIDER: gemini, groq, or openai
AI_PROVIDER=groq
# AI_API_KEY: API key for the chosen provider (Groq: https://console.groq.com/keys)
AI_API_KEY=your_ai_api_key_here
# AI_MODEL: model name for the provider (groq: openai/gpt-oss-120b, gemini: gemini-1.5-flash)
AI_MODEL=openai/gpt-oss-120b
# AI_MAX_TOKENS: Maximum tokens for AI responses
AI_MAX_TOKENS=8192
# AI_TEMPERATURE: Creativity level (0.0-1.0, higher = more creative)
AI_TEMPERATURE=0.7
# AI_RATE_LIMIT_RPM: Maximum requests per minute per faculty
AI_RATE_LIMIT_RPM=10

# Lesson Plan Processing Configuration
# MAX_UPLOAD_SIZE_MB: Maximum file size for lesson plan uploads (in megabytes)
MAX_UPLOAD_SIZE_MB=50
# ALLOWED_DOCUMENT_TYPES: Comma-separated list of allowed file extensions
ALLOWED_DOCUMENT_TYPES=pdf,docx,txt
# GENERATION_JOB_TIMEOUT_MINUTES: Timeout for async job processing
GENERATION_JOB_TIMEOUT_MINUTES=10

# Redis/Dragonfly Cache Configuration (optional - in-memory fallback if disabled)
# REDIS_ENABLED: Set to true to enable Redis caching (default: false)
REDIS_ENABLED=false
# REDIS_HOST: Redis/Dragonfly server host
REDIS_HOST=localhost
# REDIS_PORT: Redis server port
REDIS_PORT=6379
# REDIS_PASSWORD: Redis password (leave empty if not required)
REDIS_PASSWORD=
# REDIS_DB: Redis database number (default: 0)
REDIS_DB=0

# Job Queue Configuration (Redis-based queue for code execution)
# JOB_QUEUE_ENABLED: Enable job queue for handling burst submissions (requires Redis)
JOB_QUEUE_ENABLED=true
# JOB_QUEUE_WORKERS: Max concurrent Judge0 requests (20-50 recommended)
JOB_QUEUE_WORKERS=30
# JOB_QUEUE_MAX_RETRIES: Max retries per job on transient failures
JOB_QUEUE_MAX_RETRIES=3
# JOB_QUEUE_RETRY_DELAY: Initial retry delay in seconds (exponential backoff)
JOB_QUEUE_RETRY_DELAY=2

